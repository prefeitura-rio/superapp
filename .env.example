# Server-only API base URLs
NEXT_PUBLIC_TICKET_FORM_BASE_URL=https://1746.staging.app.dados.rio/protocolo
# Logout local do 1746 (Salesforce). Usado pelo "Sair" do Pref.Rio em segundo
# plano. Staging e produção usam o secur/logout.jsp do site Experience Cloud.
NEXT_PUBLIC_1746_LOGOUT_URL=https://1746.staging.app.dados.rio/solicitacaovforcesite/secur/logout.jsp
BASE_API_URL_RMI=http://localhost:3001
COURSES_BASE_API_URL=http://localhost:3002
BASE_API_URL_APP_BUSCA_SEARCH=http://localhost:3003
BASE_API_URL_SUBPAV_OSA_API=http://localhost:3004
API_KEY_SUBPAV_OSA_SMS=
BASE_API_URL_APP_CATALOGO=http://localhost:3005
BASE_API_URL_PREF_RIO_CARTA_SERVICOS=http://localhost:3008/api/
BASE_API_URL_PREF_RIO_CIDADAO=http://localhost:3006/api/private/
BASE_API_URL_PREF_RIO_CHAMADOS_PUBLICO=http://localhost:3007/api/
# Dívida Ativa (api-imoveis). Para desenvolver sem a API, suba um mock a partir do spec:
#   npx @stoplight/prism-cli mock divida-ativa-api.yaml -p 3009
# Para bater na homologação real (exige rede interna e sessão id.rio válida), troque por:
#   BASE_API_URL_DIVIDA_ATIVA=https://api-appimoveishom.apps.ocp.rio.gov.br
BASE_API_URL_DIVIDA_ATIVA=http://localhost:3009

# Integração Salesforce/MuleSoft para serviços e atendimento.
# Controla as superfícies Salesforce-only da Carta e de atendimento.
# Onde existir fallback no app-busca-search, false mantém o caminho legado.
# Ausente ou diferente de "true" desliga com segurança.
# Variável server-side (sem NEXT_PUBLIC_): lida em runtime; alterações no
# Infisical refletem após restart dos pods, sem necessidade de novo build/deploy.
FEATURE_SALESFORCE=false

# Exibe os cards de "Solicitações" na home. Independente de FEATURE_SALESFORCE:
# exige ambas as flags como "true" para mostrar a seção. Permite ocultar o bloco
# da home mantendo a integração Salesforce ativa (rotas, API, busca, banner).
# Variável server-side (sem NEXT_PUBLIC_): lida em runtime; alterações no
# Infisical refletem após restart dos pods, sem necessidade de novo build/deploy.
FEATURE_HOME_SOLICITACOES=false

# Histórico do 1746 legado (SGRC), servido pelo app-rmi: opção "abertas até
# 26/11/2026" em Minhas Solicitações e consulta de protocolos RIO-12345678-9.
# Só tem efeito com FEATURE_SALESFORCE="true". Ausente ou diferente de "true" =
# desligado: só Salesforce nessas telas, rotas SGRC respondem 404 e a carteira
# mantém o card "Cuidados com a Cidade". Produção fica desligada até a feature
# estar pronta. Variável server-side (sem NEXT_PUBLIC_): lida em runtime;
# alterações no Infisical refletem após restart dos pods, sem novo build/deploy.
FEATURE_SGRC_HISTORICO=false

# Carrossel de banners v3 da home (boas-vindas, trabalho e cursos). Ausente ou
# diferente de "true" = desligado: a home mantém os banners de sugestão
# anteriores. Produção fica desligada até a feature estar pronta.
# Variável server-side (sem NEXT_PUBLIC_): lida em runtime; alterações no
# Infisical refletem após restart dos pods, sem novo build/deploy.
FEATURE_HOME_BANNERS_V3=false

# Avaliação "Este conteúdo foi útil?" no fim da página de serviço e a rota
# POST /api/servicos/{slug}/avaliacao. Só tem efeito com FEATURE_SALESFORCE="true"
# (o voto precisa do articleId da Carta). Ausente ou diferente de "true" = o
# componente não aparece e a rota responde 404. Produção fica desligada até a
# borda ter rate limit e o IP de saída estar cadastrado no Salesforce.
# Variável server-side (sem NEXT_PUBLIC_): lida em runtime.
FEATURE_AVALIACAO_SERVICO=false

# Votação de artigos da Carta (External Client App "Votacao_API_Pref_Rio").
# Na v0 o portal chama o Apex do Salesforce direto; ao migrar para o MuleSoft,
# mudam só estas quatro variáveis. Secret só no backend (Infisical), nunca no repo.
# Staging: prefeitura-rio--staging.sandbox.my.salesforce.com
# Produção: prefeitura-rio.my.salesforce.com
SALESFORCE_VOTACAO_API_URL=https://prefeitura-rio--staging.sandbox.my.salesforce.com/services/apexrest/apis/public
SALESFORCE_VOTACAO_TOKEN_URL=https://prefeitura-rio--staging.sandbox.my.salesforce.com/services/oauth2/token
SALESFORCE_VOTACAO_CLIENT_ID=
SALESFORCE_VOTACAO_CLIENT_SECRET=

# SOMENTE LOCAL/TESTE. Reescreve links de produção vindos da Carta de Serviços
# (botões "Acessar serviço", canais, links no HTML e PDF) para homologação.
# Paliativo: o ideal é corrigir o cadastro no Salesforce. Exige FEATURE_SALESFORCE="true".
# Ausente ou diferente de "true" = desligado. NUNCA definir em produção.
# Detalhes em docs/agents/07-feature-flags-runtime.md.
REWRITE_SERVICE_URLS_TO_HML=false

# Pré-visualização da carta a partir do Salesforce Lightning.
# Ausente ou diferente de "true" responde 404 em /servicos/preview e no POST.
# Não acompanha FEATURE_SALESFORCE.
PREVIEW_CARTA_SERVICOS_ENABLED=false

# Origens exatas do Lightning que podem abrir /servicos/preview.
# Separadas por vírgula. Sem wildcard e sem path.
# Ex.: https://org.lightning.force.com,https://org--hom.sandbox.lightning.force.com
SALESFORCE_PREVIEW_ORIGINS=

# Flags legadas mantidas apenas para referência durante a migração.
# O runtime usa exclusivamente FEATURE_SALESFORCE.
NEXT_PUBLIC_FEATURE_CHAMADOS=false
# Dívida Ativa: ausente ou diferente de "true" oculta todo o módulo /divida-ativa.
# Staging e produção ficam em "false" até o módulo estar pronto para o cidadão.
NEXT_PUBLIC_FEATURE_DIVIDA_ATIVA=true
# VLibras Widget (tradução para Libras). Ausente ou vazio = desligado.
# O script se inicializa sozinho; a CSP precisa liberar vlibras.gov.br e cdn.jsdelivr.net.
NEXT_PUBLIC_VLIBRAS_ENABLED=
# Plugin de acessibilidade (complementar ao VLibras). Ausente ou vazio = desligado.
# Roda local (sem CDN); nenhuma mudança de CSP necessária.
NEXT_PUBLIC_ACCESSIBILITY_ENABLED=
# Dados de exemplo no lugar de erros da API de divida ativa (so em `next dev`). Desligado,
# o erro real aparece na tela — ligue so para navegar o fluxo sem a API.
DIVIDA_ATIVA_DEV_FIXTURES=false

# Google Cloud Storage — CadMicro file upload (signed URLs, private objects)
# Same credentials pattern as portal-interno image upload.
GCS_BUCKET_NAME=rj-superapp-staging-prefrio
GCS_CLIENT_EMAIL=prefrio-media-upload@rj-superapp-staging.iam.gserviceaccount.com
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Rio Queue — controle de acesso por fila virtual
# URL do bucket onde rio-queue.min.js está hospedado (ex: GCS).
NEXT_PUBLIC_RIO_QUEUE_URL=https://storage.googleapis.com/rio-queue
# URL da API backend do rio-queue. Deve ser diferente do bucket acima.
# Enquanto vazia, o QueueGate não renderiza e todos passam direto.
NEXT_PUBLIC_RIO_QUEUE_API_URL=https://rio-queue.dados.rio

# OpenTelemetry Configuration
# Enable/disable OpenTelemetry tracing
OTEL_ENABLED=false

# OpenTelemetry collector endpoint (gRPC)
# For Signoz: typically http://signoz-otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Service identification
OTEL_SERVICE_NAME=citizen-portal
OTEL_SERVICE_VERSION=0.1.0

# Deployment environment (development, staging, production)
OTEL_ENVIRONMENT=development

# Trace sampling configuration
# OTEL_TRACES_SAMPLER options:
#   - always_on: Sample all traces (recommended for dev/staging)
#   - traceidratio: Sample a percentage of traces (recommended for production)
# Default: always_on
OTEL_TRACES_SAMPLER=always_on

# Sampling ratio when using traceidratio sampler (0.0 to 1.0)
# Examples:
#   - 1.0 = 100% (sample all traces)
#   - 0.1 = 10% (sample 10% of traces - good for high-traffic production)
#   - 0.01 = 1% (sample 1% of traces - for very high traffic)
# Default: 1.0
OTEL_TRACES_SAMPLER_ARG=1.0
