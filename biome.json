{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "organizeImports": {
    "enabled": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "asNeeded",
      "jsxQuoteStyle": "double",
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useFocusableInteractive": "off",
        "useSemanticElements": "off",
        "useKeyWithClickEvents": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noUnusedTemplateLiteral": "off"
      },
      "nursery": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@next/third-parties/google": "Use sendGAEvent de '@/lib/analytics/send-ga-event' e o ConsentGatedAnalytics: o GA só pode rodar com consentimento de cookies (LGPD). Não use GoogleTagManager."
            }
          }
        }
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noImplicitAnyLet": "off",
        "noExplicitAny": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "complexity": {
        "useOptionalChain": "off",
        "noForEach": "off"
      }
    }
  },
  "files": {
    "ignore": [
      ".next/**",
      "next.config.js",
      "next-env.d.ts",
      "tsconfig.json",
      "node_modules/**",
      "package-lock.json",
      "**/*.js",
      "public/pdf.worker.min.mjs",
      "coverage/**",
      "playwright-report/**",
      "test-results/**"
    ]
  },
  "overrides": [
    {
      "include": [
        "src/lib/analytics/send-ga-event.ts",
        "src/lib/analytics/__tests__/send-ga-event.test.ts",
        "src/components/consent-gated-analytics.tsx"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "include": [
        "src/http/**",
        "src/http-agent-api/**",
        "src/http-app-catalogo/**",
        "src/http-busca-search/**",
        "src/http-courses/**",
        "src/http-divida-ativa/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConfusingVoidType": "off"
          }
        }
      }
    }
  ]
}
